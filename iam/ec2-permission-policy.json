{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCvObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3050/site/*"
    },
    {
      "Sid": "ListOnlySitePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cv-23l-3050",
      "Condition": {
        "StringEquals": { "s3:prefix": "site/" }
      }
    }
  ]
}
